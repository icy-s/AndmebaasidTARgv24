ALTER TRIGGER [dbo].[linnaLisamine]
ON [dbo].[linnad] --tabelinimi, mis on vaja jälgida
FOR INSERT
AS
INSERT INTO logi(kasutaja, aeg, toiming, andmed)
SELECT
SUSER_NAME(), --USER
GETDATE(),
'on tehtud INSERT käsk',
CONCAT (inserted.linnanimi, ', elanike arv:', inserted.rahvaarv)
FROM inserted;



